# Build context is the repo root (docker build -f deploy/Dockerfile .)

# Secrets, VCS and local tooling never enter the image
.env
.env.*
.git
.github
.claude
.playwright-mcp
.tours
.superpowers
.ruff_cache
**/__pycache__
**/*.pyc
*.log

# Client data, reference decks and run output stay on the workstation
Baby-Skincare_Category/
Band-Aid/
Planet-Fitness/
PPT Templates/
ui-*.png
backend/tests/
backend/static/
docs/

# Runtime data: the image ships only the deck templates under data/
data/*
!data/hunter_template.pptx
!data/hunter_template_skeleton.pptx

# Frontend dependencies and builds are reinstalled inside the image
frontend/node_modules/
frontend/dist/
