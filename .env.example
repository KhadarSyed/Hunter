# Hunter Intelligence Platform - Environment Variables
# Copy this file to .env and fill in your keys
#
# LLM provider chain (see agent/app/core/llm_provider.py):
#   Chat:       Azure OpenAI -> Anthropic -> local Ollama
#   Embeddings: NVIDIA NIM   -> local Ollama
# Leave a tier's vars blank to skip it and fall through to the next one.

# Anthropic API Key (Claude LLM) - chat fallback tier 2
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Azure OpenAI (chat fallback tier 1 - takes priority over Anthropic when set)
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-AZURE-KEY-HERE

# NVIDIA NIM embeddings (embedding fallback tier 1 - takes priority over Ollama when set)
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_API_KEY=YOUR-NVIDIA-KEY-HERE
NVIDIA_EMBED_API_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Nemotron-Parse OCR fallback (agent/app/core/nvidia_parse_client.py) - used by
# /api/intel/brief/parse-file only when text-layer extraction of an uploaded PDF/PPTX/DOCX comes
# back near-empty (likely a scanned document). Optional: if NVIDIA_PARSE_API_KEY is left unset, it
# falls back to NVIDIA_EMBED_API_KEY (same NVIDIA account may cover both NIM models - unverified).
# Leaving both unset just disables the OCR fallback; uploads still work, ocr_used stays false.
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse
NVIDIA_PARSE_API_KEY=YOUR-NVIDIA-KEY-HERE
NVIDIA_PARSE_API_URL=https://integrate.api.nvidia.com/v1

# Ollama (local LLM) - final fallback tier for both chat and embeddings
OLLAMA_HOST=http://localhost:11434

# SerpAPI (Google News engine) - agent/app/domains/research/news_search.py
# Optional: leaving this blank just skips the SerpAPI source; Google News RSS (keyless) still
# runs on its own.
SERP_API_KEY=YOUR-SERPAPI-KEY-HERE

# Tavily Search API - agent/app/domains/research/news_search.py
# Optional, third search source alongside SerpAPI + Google News RSS. If BOTH SerpAPI and Tavily
# are unavailable/unconfigured, research still runs on Google News RSS alone and the research
# result is flagged (search_degraded=true / a research_gaps entry) so the UI can notify the user.
TAVILY_API_KEY=YOUR-TAVILY-KEY-HERE
