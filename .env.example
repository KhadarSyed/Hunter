# Hunter Intelligence Platform - Environment Variables
# Copy this file to .env and fill in your keys
#
# LLM provider chain (see agent/app/core/llm_provider.py):
#   Chat:       Azure OpenAI only. No fallback — chat() raises a clear error if this
#               is not configured.
#   Embeddings: NVIDIA NIM only. No fallback — embed()/embed_batch() raise a clear
#               error if this is not configured (unrelated feature: semantic slide/deck search).
# ANTHROPIC_API_KEY is unused (kept only so core/anthropic_client.py's AnthropicClient class
# still imports cleanly if something constructs it directly; the chat chain never selects it).
ANTHROPIC_API_KEY=

# Azure OpenAI (the only chat provider)
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-AZURE-KEY-HERE

# NVIDIA NIM embeddings
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_API_KEY=YOUR-NVIDIA-KEY-HERE
NVIDIA_EMBED_API_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Nemotron-Parse OCR fallback (agent/app/core/nvidia_parse_client.py) - used by
# /api/intel/brief/parse-file only when text-layer extraction of an uploaded PDF/PPTX/DOCX comes
# back near-empty (likely a scanned document). Optional: if NVIDIA_PARSE_API_KEY is left unset, it
# falls back to NVIDIA_EMBED_API_KEY (same NVIDIA account may cover both NIM models - unverified).
# Leaving both unset just disables the OCR fallback; uploads still work, ocr_used stays false.
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse
# nvidia = Nemotron-Parse first (Office files converted to PDF via LibreOffice or MS Office), native fallback
# native = offline extraction only (python-docx / python-pptx / openpyxl / PyMuPDF)
BRIEF_EXTRACTION_MODE=nvidia
NVIDIA_PARSE_API_KEY=YOUR-NVIDIA-KEY-HERE
NVIDIA_PARSE_API_URL=https://integrate.api.nvidia.com/v1

# SerpAPI (Google News engine + Google Images logo fallback) - agent/app/domains/research/news_search.py,
# agent/app/domains/research/brandfetch.py
# Optional: leaving this blank just skips the SerpAPI source; Google News RSS (keyless) still
# runs on its own.
SERP_API_KEY=YOUR-SERPAPI-KEY-HERE
# Several SerpAPI keys, used in order; a key that runs out of searches rests for an hour:
# SERP_API_KEYS=key1,key2,key3

# Tavily Search API - agent/app/domains/research/news_search.py
# Optional, third search source alongside SerpAPI + Google News RSS. If BOTH SerpAPI and Tavily
# are unavailable/unconfigured, research still runs on Google News RSS alone and the research
# result is flagged (search_degraded=true / a research_gaps entry) so the UI can notify the user.
TAVILY_API_KEY=YOUR-TAVILY-KEY-HERE

# Brandfetch — brand logos on project cards (domains/research/brandfetch.py, GET /api/intel/brandfetch/logo)
# and the Brandfetch MCP server in .mcp.json (Claude Code expands ${BRANDFETCH_API_KEY} from the environment).
# Get both from https://developers.brandfetch.com. The client ID is public (embedded in CDN logo URLs).
BRANDFETCH_API_KEY=YOUR-BRANDFETCH-API-KEY-HERE
BRANDFETCH_CLIENT_ID=YOUR-BRANDFETCH-CLIENT-ID-HERE

# Pexels — dynamic brand-related background photo on the Brief & Scope header
# (domains/research/pexels.py, GET /api/intel/pexels/image). Get a free key from
# https://www.pexels.com/api/. Optional: leaving it unset just skips the background image.
PEXEL_API_KEY=YOUR-PEXELS-API-KEY-HERE
