# Hunter Intelligence Platform - environment variables
# Copy to .env (repo root). Every name below is read by backend code; anything not listed here is ignored.
# Optional services are skipped when their key is blank.

# ---- Required ---------------------------------------------------------------------------------
# Postgres (the only database). Local: docker compose -f deploy/docker-compose.postgres.yml up -d
DATABASE_URL=postgresql://hunter:hunter@127.0.0.1:5433/hunter
# development | production. Production refuses to start without API_KEY.
ENVIRONMENT=development
API_KEY=

# ---- Secrets with safe fallbacks --------------------------------------------------------------
# Encrypts organisations' provider / data-source keys (Fernet key: Fernet.generate_key()).
# Unset: derived from DATABASE_URL. Changing it makes saved keys unreadable (re-enter them).
PROVIDER_SECRET_KEY=
# Signs WebSocket tickets. Unset: a random key per process (set it when running several instances).
WS_TICKET_SECRET=
# First Super Admin: created/promoted at startup ONLY while no Super Admin exists (fresh database).
SEED_SUPER_ADMIN_EMAIL=
# Its first password. Unset: a random one is logged once and must be changed at sign-in.
SEED_SUPER_ADMIN_PASSWORD=

# ---- App / email ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# Browser origins (besides this server itself) allowed to call the API with the session cookie, e.g. the
# Vercel frontend: comma list or JSON array of exact origins; never "*". Unset: http://localhost:5173 (Vite dev).
CORS_ORIGINS=
# Base URL for links in emails. Unset: RENDER_EXTERNAL_URL, else http://localhost:5173
APP_URL=
# ZeptoMail SMTP. Blank server/password/sender = emails are skipped.
ZEPTO_SERVER=
ZEPTO_SMTP_PORT=587
ZEPTO_USERNAME=emailapikey
ZEPTO_PASSWD_KEY=
ZEPTO_FROM=
MAIL_FROM_NAME=Hunter

# ---- Platform LLM (only orgs flagged platform_llm; other orgs add their own in Settings > LLM Providers)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# gpt-5 only: minimal | low | medium | high. Unset = model default.
AZURE_OPENAI_REASONING_EFFORT=

# ---- Embeddings (EMBEDDING_MODEL_* first, NVIDIA_EMBED_* as fallback names) -------------------
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_BASE_URL=
EMBEDDING_MODEL_NAME=
NVIDIA_EMBED_API_KEY=
NVIDIA_EMBED_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# ---- Brief file OCR (domains/brief/parser.py) -------------------------------------------------
# nvidia = Nemotron-Parse first, native fallback | native = offline extraction only
BRIEF_EXTRACTION_MODE=nvidia
NVIDIA_PARSE_API_KEY=
NVIDIA_PARSE_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse

# ---- File storage (optional; without it everything stays in Postgres) -------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# ---- Research sources (all optional) ----------------------------------------------------------
SERP_API_KEY=
# Several SerpAPI keys, used in order: SERP_API_KEYS=key1,key2
SERP_API_KEYS=
TAVILY_API_KEY=
BRANDFETCH_API_KEY=
BRANDFETCH_CLIENT_ID=
YOUTUBE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
SEARXNG_URL=
FIRECRAWL_SEARCH_ENABLED=

# ---- Deck photos (domains/deckstudio/assets.py) -----------------------------------------------
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
IMAGE_SOURCE=
IMAGE_LICENSED_PROVIDERS=

# ---- Optional tuning (leave unset for code defaults; see the named file) ----------------------
# HUNTER_AGENT_DATA_DIR=             core/config.py (default: data/)
# HUNTER_AGENT_INPUT_ROOTS=          core/config.py, ';'-separated folders the agent may read
# HUNTER_LOW_MEMORY=                 core/config.py, 1/0 overrides container detection
# HUNTER_PG_SCHEMA_PER_DB=           core/db.py
# HUNTER_ENRICH_WORKERS=             domains/dataset/tagging_job.py
# HUNTER_TAG_ARTICLE_CHARS= HUNTER_TAG_INPUT_TOKENS= HUNTER_TAG_OUTPUT_TOKENS=
# HUNTER_BATCH_INSIGHTS=             domains/deliverable/insights_batch.py
# HUNTER_EXTRACT_SAMPLE=             domains/deliverable/extract.py
# LLM_LIGHT_TASKS=                   core/llm_effort.py
# TYPESAFE_API_KEY= TYPESAFE_MODEL=  core/jev_client.py
# LLM_PRICE_INPUT_PER_1M= LLM_PRICE_OUTPUT_PER_1M=   core/config.py (tagging cost estimate)
