{% set bg = ("url('" ~ image ~ "')") if image else ("linear-gradient(135deg,#" ~ t.accent ~ ",#" ~ t.primary ~ ")") %}
{% set n_label = ((s.charts[0].get('n') if s.charts else none) or base_n) %}{# a chart's own base; the deck base for others #}
<section class="slide" style="--chip-dark:{{ marks.chip_dark or 'var(--text)' }}" data-id="{{ s.id }}" data-type="{{ s.type }}" data-treatment="{{ s.treatment }}">
{% if s.type == "objectives" %}
  <div class="photo" style="right:56px;top:46px;bottom:70px;width:560px;border-radius:{{ t.radius }}px;background-image:{{ bg }}"></div>
  <div class="obj{% if s.cards|length > 6 %} dense{% endif %}">
    <div class="title" style="font-size:60px">{{ s.title }}</div>
    {% if s.kicker %}<div class="obj-label">{{ s.kicker }}{% if s.cards|length > 1 %}s{% endif %}</div>{% endif %}
    {% if s.so_what %}<p class="obj-lead">{{ s.so_what }}</p>{% endif %}
    <ol class="obj-list">{% for c in s.cards %}<li>{{ c.headline }}</li>{% endfor %}</ol>
    {% if s.tables and s.tables[0].rows %}<div class="obj-scope">{% for row in s.tables[0].rows %}<div><strong>{{ row[0] }}:</strong> <span>{{ row[1] }}</span></div>{% endfor %}</div>{% endif %}
  </div>
{% elif s.treatment == "full" %}
  <div class="photo" style="inset:0;background-image:{{ bg }}"></div><div class="overlay"></div>
  <div class="reveal" style="position:absolute;left:110px;right:110px;top:{{ 520 if s.type == 'cover' else 330 }}px;color:var(--on-dark)">
    {% if s.kicker %}<div class="kicker" style="color:var(--on-dark);opacity:.85">{{ s.kicker }}</div>{% endif %}
    {% if s.question %}<div class="question clamp" style="margin-top:18px">{{ s.question }}</div>
    {% else %}<div class="title clamp" style="color:var(--on-dark);font-size:84px">{{ s.title }}</div>{% endif %}
    {% if s.so_what %}<div class="sowhat clamp" style="margin-top:22px;opacity:.95">{{ s.so_what }}</div>{% endif %}
    {% if s.type == 'cover' and s.notes %}<div class="kicker" style="margin-top:26px;color:var(--on-dark);opacity:.8">{{ s.notes }}</div>{% endif %}
  </div>
  {% if s.type == 'cover' and marks.brand %}<div class="logo-chip cover{% if marks.brand_light %} dark{% endif %}" style="position:absolute;left:110px;top:90px;display:flex;align-items:center;gap:24px">{% if marks.symbol %}<img class="brand-symbol" src="{{ marks.symbol }}" alt="" style="height:120px;width:120px;object-fit:contain;border-radius:18px">{% endif %}<img class="brand-logo" src="{{ marks.brand }}" alt="{{ marks.name }}" style="height:120px;max-width:440px;object-fit:contain"></div>{% endif %}
  {% if s.type == 'cover' and marks.product %}<div class="product-card" style="position:absolute;right:110px;top:90px;width:420px"><img class="product-shot" src="{{ marks.product }}" alt="{{ marks.product_name }}"><div class="kicker" style="margin-top:12px">{{ marks.product_name }}</div></div>{% endif %}
  {% if s.type == 'cover' and marks.strip %}<div style="position:absolute;left:110px;right:110px;bottom:64px;display:flex;align-items:center;gap:16px;flex-wrap:wrap"><span class="kicker" style="color:var(--on-dark);opacity:.85;margin-right:6px">Brand and competitive set</span>{% for name, rel, light in marks.strip %}<span class="logo-chip{% if light %} dark{% endif %}"><img src="{{ rel }}" alt="{{ name }}" style="height:40px;max-width:150px;object-fit:contain"></span>{% endfor %}</div>{% endif %}
{% elif s.treatment == "A" %}
  <div class="photo" style="inset:0;background-image:{{ bg }}"></div><div class="overlay"></div>
  <div style="position:absolute;left:70px;top:56px;width:1120px;color:var(--on-dark)">
    {% if s.kicker %}<div class="kicker" style="color:var(--on-dark);opacity:.85">{{ s.kicker }}</div>{% endif %}
    <div class="title clamp" style="color:var(--on-dark);margin-top:10px;font-size:46px">{{ s.question or s.title }}</div>
  </div>
  {% if s.so_what %}<div class="sowhat clamp" style="position:absolute;right:70px;top:66px;width:560px;color:var(--on-dark)">{{ s.so_what }}</div>{% endif %}
  <div class="panel reveal" style="left:70px;top:320px;width:{{ 1090 if ((charts or s.tables) and s.cards) else 1780 }}px;height:680px;overflow:hidden">
    {% if s.title and s.question %}<div class="kicker" style="margin-bottom:12px">{{ s.title }}</div>{% endif %}
    {% if charts %}<div style="height:580px">{{ charts[0] | safe }}</div>
    {% elif s.tables and s.type != 'scorecard' %}{% include "table.html.j2" %}
    {% elif not s.tables or s.type == 'scorecard' %}<div class="cards" style="grid-template-columns:repeat({{ [s.cards|length, 3]|min or 1 }},1fr)">
      {% for c in s.cards[:6] %}<div class="card build">{% if c.thumb %}<img class="thumb" src="{{ c.thumb }}" alt="">{% endif %}<h3 class="clamp">{{ c.headline }}</h3><p class="clamp">{{ c.text }}{% if c.note %} — {{ c.note }}{% endif %}</p>{% if c.citations and marks.cites %}<div class="cites">{% for n in c.citations[:3] %}{% set m = marks.cites.get(n|string) %}{% if m %}{% if m.url %}<a class="cite" href="{{ m.url }}">{% else %}<span class="cite">{% endif %}{% if m.icon %}<img src="{{ m.icon }}" alt="">{% endif %}{{ m.outlet }}{% if m.url %}</a>{% else %}</span>{% endif %}{% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}</div>
      {% if s.type == 'scorecard' and s.tables and s.tables[0].rows %}<div style="margin-top:22px">{% include "table.html.j2" %}</div>{% endif %}
    {% endif %}
  </div>
  {% if (charts or (s.tables and s.type != 'scorecard')) and s.cards %}<div class="cards reveal" style="position:absolute;left:1190px;right:70px;top:320px;grid-template-columns:1fr">
    {% for c in s.cards[:3] %}<div class="card build" style="background:rgba(255,255,255,.94)">{% if c.thumb %}<img class="thumb" src="{{ c.thumb }}" alt="">{% endif %}<h3 class="clamp">{{ c.headline }}</h3><p class="clamp">{{ c.text }}</p>{% if c.citations and marks.cites %}<div class="cites">{% for n in c.citations[:3] %}{% set m = marks.cites.get(n|string) %}{% if m %}{% if m.url %}<a class="cite" href="{{ m.url }}">{% else %}<span class="cite">{% endif %}{% if m.icon %}<img src="{{ m.icon }}" alt="">{% endif %}{{ m.outlet }}{% if m.url %}</a>{% else %}</span>{% endif %}{% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
  {% if charts %}<div class="nlabel" style="position:absolute;right:80px;top:280px;color:var(--on-dark)">N = {{ n_label }}</div>{% endif %}
{% elif s.treatment == "S" %}
  <div style="position:absolute;left:70px;right:70px;top:48px">
    {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
    <div class="title clamp" style="margin-top:8px;font-size:38px;-webkit-line-clamp:2">{{ s.question or s.title }}</div>
    {% if s.question and s.title %}<div class="kicker" style="margin-top:10px;color:var(--muted)">{{ s.title }}</div>{% endif %}
  </div>
  <div class="panel reveal" style="left:70px;top:240px;width:680px;height:760px;overflow:hidden">
    <div class="nlabel" style="text-align:right">N = {{ n_label }}</div>
    {% if charts %}{{ charts[0] | safe }}{% elif s.tables %}{% include "table.html.j2" %}{% endif %}
  </div>
  <div class="segs reveal">
    {% for c in s.cards[:5] %}<div class="seg build"><p class="clamp"><strong class="seg-label">{{ c.headline }}:</strong> {{ c.text | md_bold }}</p>{% if c.citations and marks.cites %}<div class="cites">{% for n in c.citations[:3] %}{% set m = marks.cites.get(n|string) %}{% if m %}{% if m.url %}<a class="cite" href="{{ m.url }}">{% else %}<span class="cite">{% endif %}{% if m.icon %}<img src="{{ m.icon }}" alt="">{% endif %}{{ m.outlet }}{% if m.url %}</a>{% else %}</span>{% endif %}{% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}
  </div>
{% elif s.treatment == "C" %}
  <div class="photo" style="left:0;top:0;bottom:0;width:672px;background-image:{{ bg }}"></div>
  <div class="overlay" style="right:auto;width:672px"></div>
  {% if s.so_what %}<div class="sowhat clamp" style="position:absolute;left:56px;bottom:90px;width:560px;color:var(--on-dark)">{{ s.so_what }}</div>{% endif %}
  <div style="position:absolute;left:740px;right:70px;top:56px">
    {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
    <div class="title clamp" style="margin-top:10px;font-size:40px">{{ s.question or s.title }}</div>
    {% if s.question and s.title %}<div class="kicker" style="margin-top:14px;color:var(--muted)">{{ s.title }}</div>{% endif %}
  </div>
  <div class="nlabel" style="position:absolute;right:80px;top:290px">N = {{ n_label }}</div>
  <div class="reveal" style="position:absolute;left:740px;right:70px;top:330px;height:{{ 380 if s.cards else 660 }}px;overflow:hidden">
    {% if charts %}{{ charts[0] | safe }}{% elif s.tables %}{% include "table.html.j2" %}{% endif %}
  </div>
  {% if s.cards %}<div class="cards reveal" style="position:absolute;left:740px;right:70px;top:730px;grid-template-columns:repeat({{ [s.cards|length, 3]|min }},1fr)">
    {% for c in s.cards[:3] %}<div class="card build"><h3 class="clamp">{{ c.headline }}</h3><p class="clamp">{{ c.text }}</p>{% if c.citations and marks.cites %}<div class="cites">{% for n in c.citations[:3] %}{% set m = marks.cites.get(n|string) %}{% if m %}{% if m.url %}<a class="cite" href="{{ m.url }}">{% else %}<span class="cite">{% endif %}{% if m.icon %}<img src="{{ m.icon }}" alt="">{% endif %}{{ m.outlet }}{% if m.url %}</a>{% else %}</span>{% endif %}{% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}</div>{% endif %}
{% elif s.type == "verbatim_wall" %}
  <div class="vband">
    {% if s.question %}<div class="vkicker">{{ s.question }}</div>{% endif %}
    <div class="vtitle clamp">{{ s.title }}</div>
  </div>
  <div class="vwall reveal">
    {% for c in s.cards[:8] %}<figure class="vcell build">{% if c.url %}<a class="vlink" href="{{ c.url }}">{% endif %}{% if c.image %}<img class="vshot" src="{{ c.image }}" alt="{{ c.headline }} · {{ c.text }}">{% endif %}{% if c.url %}</a>{% endif %}</figure>{% endfor %}
  </div>
  <div class="vnote">The above insights are based on analysis of a representative sample of data.</div>
{% elif s.type == "methodology" %}
  <div style="position:absolute;left:70px;right:70px;top:56px">
    <div class="title clamp" style="font-size:46px">{{ s.title }}</div>
  </div>
  <div class="reveal" style="position:absolute;left:70px;right:70px;top:150px;bottom:80px;display:flex;flex-direction:column;gap:22px;overflow:hidden">
    {% if s.cards %}<ul class="defs">{% for c in s.cards %}<li>{{ c.text }}</li>{% endfor %}</ul>{% endif %}
    {% if s.tables %}{% set tb = s.tables[0] %}<div class="qtable"><table>
      <colgroup><col style="width:80px"><col style="width:30%"><col></colgroup>
      <thead><tr>{% for h in tb.header %}<th>{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in tb.rows %}<tr><td class="qid">{{ row[0] }}</td><td class="qtext">{{ row[1] }}</td><td class="qquery">{{ row[2] }}</td></tr>{% endfor %}</tbody>
    </table></div>{% endif %}
  </div>
{% else %}
  <div style="position:absolute;left:70px;right:70px;top:56px">
    {% if s.kicker %}<div class="kicker">{{ s.kicker }}</div>{% endif %}
    <div class="title clamp" style="margin-top:10px">{{ s.title }}</div>
  </div>
  {% set side = s.tables and s.cards and s.type not in ("checklist", "citations") %}
  <div class="reveal" style="position:absolute;left:70px;right:{{ 760 if side else 70 }}px;top:210px;bottom:80px;overflow:hidden">
    {% if s.tables %}{% include "table.html.j2" %}
    {% else %}{% for c in s.cards %}<p style="font-size:22px;line-height:1.5;margin-bottom:12px">{{ c.text }}</p>{% endfor %}{% endif %}
  </div>
  {% if side %}<div class="cards reveal" style="position:absolute;left:1190px;right:70px;top:210px;grid-template-columns:1fr">
    {% for c in s.cards[:3] %}<div class="card build"><h3 class="clamp">{{ c.headline }}</h3><p class="clamp">{{ c.text | md_bold }}</p>{% if c.citations and marks.cites %}<div class="cites">{% for n in c.citations[:3] %}{% set m = marks.cites.get(n|string) %}{% if m %}{% if m.url %}<a class="cite" href="{{ m.url }}">{% else %}<span class="cite">{% endif %}{% if m.icon %}<img src="{{ m.icon }}" alt="">{% endif %}{{ m.outlet }}{% if m.url %}</a>{% else %}</span>{% endif %}{% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}
  </div>{% endif %}
{% endif %}
  {% if s.type not in ("cover", "closing", "divider") %}
  <div class="footer" style="{% if s.treatment == 'A' %}color:var(--on-dark){% elif s.treatment == 'C' %}left:672px{% endif %}"><span>Source: {{ source }} | {{ period }}</span><span style="display:flex;align-items:center;gap:14px">{% if marks.brand %}<span class="logo-chip mark{% if marks.brand_light %} dark{% endif %}"><img class="brand-mark" src="{{ marks.brand }}" alt="{{ marks.name }}" style="height:20px;max-width:100px;object-fit:contain"></span>{% endif %}{{ n }} / {{ total }}</span></div>{% endif %}
</section>
