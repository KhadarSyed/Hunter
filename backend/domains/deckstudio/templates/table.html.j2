{% set tb = s.tables[0] %}<table><thead><tr>{% for h in tb.header %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>
{% for row in tb.rows[:12] %}<tr>{% for cell in row %}<td{% if cell in ("covered", "partial", "missing") %} class="status-{{ cell }}"{% endif %}>{% if logos and cell in logos %}<img class="cell-logo" src="{{ logos[cell] }}" alt="" style="height:22px;width:22px;object-fit:contain;vertical-align:middle;margin-right:8px;border-radius:4px">{% endif %}{{ cell }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table>
