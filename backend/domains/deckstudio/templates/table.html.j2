{% set tb = s.tables[0] %}{% set widths = tb.col_widths or [] %}{% set total = widths | sum %}<table>
{% if widths and widths | length == tb.header | length %}<colgroup>{% for w in widths %}<col style="width:{{ (100 * w / total) | round(1) }}%">{% endfor %}</colgroup>{% endif %}
<thead><tr>{% for h in tb.header %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>
{% for row in tb.rows[:table_cap] %}{% set link = (tb.links or [])[loop.index0] if (tb.links or []) | length > loop.index0 else "" %}<tr>{% for cell in row %}{% set pct = (cell[:-1] | float) if (tb.heat and cell is string and cell.endswith("%") and not loop.first) else none %}<td{% if cell in ("covered", "partial", "missing") %} class="status-{{ cell }}"{% endif %}{% if pct is not none %} style="background:color-mix(in srgb, #{{ t.primary }} {{ (pct * 0.75) | round(0) }}%, transparent);{% if pct > 55 %}color:#fff;{% endif %}font-weight:600"{% endif %}><div class="cell">{% if logos and cell in logos %}<img class="cell-logo{% if cell in light_logos %} dark{% endif %}" src="{{ logos[cell] }}" alt="">{% endif %}{% if loop.first and link %}<a class="cell-link" href="{{ link }}">{{ cell }}</a>{% else %}{{ cell }}{% endif %}</div></td>{% endfor %}</tr>{% endfor %}
</tbody></table>
